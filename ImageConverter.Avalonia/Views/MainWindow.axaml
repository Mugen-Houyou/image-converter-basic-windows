<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ImageConverter.Core.Models;assembly=ImageConverter.Core"
        xmlns:conv="clr-namespace:ImageConverter.Avalonia.Converters"
        x:Class="ImageConverter.Avalonia.Views.MainWindow"
        Title="이미지 변환기"
        MinWidth="1120" MinHeight="550"
        Width="1180" Height="600"
        Background="{StaticResource ClassicWindowBg}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:FilePathToBitmapConverter x:Key="PathToImage" />
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: 상단 버튼 바 -->
        <Border Grid.Row="0" Padding="4"
                Background="{StaticResource ClassicButtonFace}" CornerRadius="0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="파일 추가" Padding="8,4" MinWidth="70" Margin="0,0,6,0"
                            Command="{Binding AddFilesCommand}" />
                    <Button Content="변환 시작" Padding="8,4" MinWidth="70" Margin="0,0,6,0"
                            Command="{Binding StartConversionCommand}" />
                    <Button Content="목록 지우기" Padding="8,4" MinWidth="70" Margin="0,0,10,0"
                            Command="{Binding ClearFilesCommand}" />
                    <ComboBox ItemsSource="{Binding OutputFormatNames}"
                              SelectedItem="{Binding SelectedOutputFormatName}"
                              VerticalAlignment="Center" Margin="6,0,0,0" />
                    <Border Background="Transparent"
                            PointerPressed="WebpArea_PointerPressed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding QualityText}" VerticalAlignment="Center"
                                       Width="74" TextAlignment="Right" Margin="4,0,6,0" />
                            <Slider Value="{Binding QualitySliderPosition}" Minimum="0" Maximum="100"
                                    Width="100" VerticalAlignment="Center"
                                    SmallChange="1" LargeChange="10" TickFrequency="1"
                                    Opacity="{Binding SliderOpacity}" />
                        </StackPanel>
                    </Border>
                    <!-- Auto 품질 보정 정도: 품질이 Auto이고 WEBP일 때만 켜진다.
                         툴팁은 슬라이더가 꺼져 있어도 보이도록 감싸는 패널에 건다.
                         0~200%이고 기본값 100%가 가운데라, 마우스로도 정확히 놓을 수 있게 5% 단위로 붙인다 -->
                    <StackPanel Orientation="Horizontal" Background="Transparent"
                                ToolTip.Tip="압축이 잘 되는 이미지는 품질을 올리고, 아주 복잡한 이미지는 내립니다 (품질 Auto, WEBP에서만 동작)">
                        <TextBlock Text="{Binding AutoCorrectionText}" VerticalAlignment="Center"
                                   Width="104" TextAlignment="Right" Margin="0,0,6,0"
                                   Opacity="{Binding AutoCorrectionOpacity}" />
                        <Slider Value="{Binding AutoCorrectionPercent}" Minimum="0" Maximum="200"
                                Width="100" VerticalAlignment="Center"
                                SmallChange="5" LargeChange="20"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                IsEnabled="{Binding IsAutoCorrectionEnabled}" />
                    </StackPanel>
                    <CheckBox Content="EXIF 제거" IsChecked="{Binding RemoveExif}"
                              VerticalAlignment="Center" Margin="10,0,0,0" />
                    <CheckBox Content="타깃 용량" IsChecked="{Binding IsTargetSizeEnabled}"
                              VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBox Text="{Binding TargetSizeKb, Mode=TwoWay}" Width="56"
                             VerticalAlignment="Center" Margin="4,0,2,0"
                             Opacity="{Binding TargetSizeOpacity}" />
                    <TextBlock Text="KB" VerticalAlignment="Center"
                               Opacity="{Binding TargetSizeOpacity}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="ℹ" Padding="6,2" MinWidth="30"
                            FontSize="14" ToolTip.Tip="About"
                            Click="AboutButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Etched horizontal separator (Win9x style — shadow over highlight) -->
        <StackPanel Grid.Row="1" Margin="0,4,0,4">
            <Border Height="1" Background="{StaticResource ClassicButtonShadow}" />
            <Border Height="1" Background="{StaticResource ClassicButtonHilight}" />
        </StackPanel>

        <!-- Row 2: 좌우 패널 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: ListBox + 안내 문구 -->
            <Grid Grid.Column="0">
                <!-- Chiseled inset frame (Win9x sunken border) -->
                <Border BorderBrush="{StaticResource ClassicButtonShadow}"
                        BorderThickness="1,1,0,0">
                <Border BorderBrush="{StaticResource ClassicButtonHilight}"
                        BorderThickness="0,0,1,1">
                <ListBox x:Name="FileListBox"
                         Background="{StaticResource ClassicWindow}"
                         BorderThickness="0"
                         ItemsSource="{Binding Files}"
                         SelectionMode="Multiple"
                         KeyDown="FileList_KeyDown"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         DragDrop.AllowDrop="True"
                         DragDrop.DragEnter="FileList_DragEnter"
                         DragDrop.DragOver="FileList_DragOver"
                         DragDrop.DragLeave="FileList_DragLeave"
                         DragDrop.Drop="FileList_Drop">
                    <!-- 미리보기 툴팁은 행 전체(ListBoxItem)에 건다. Template으로 감싸야 항목마다 새 인스턴스가 생긴다 -->
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="ToolTip.ShowDelay" Value="300" />
                            <Setter Property="ToolTip.BetweenShowDelay" Value="200" />
                            <Setter Property="ToolTip.Tip">
                                <Template>
                                    <StackPanel>
                                        <Image Source="{Binding FilePath, Converter={StaticResource PathToImage}}"
                                               MaxWidth="240" MaxHeight="240"
                                               Stretch="Uniform" />
                                        <TextBlock Text="{Binding PreviewInfoText}" FontSize="11"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Template>
                            </Setter>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:ImageFileItem">
                            <StackPanel Orientation="Horizontal" Margin="4,2">
                                <TextBlock Text="{Binding FileName}" Width="180" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding FileSizeText}" Width="60" TextAlignment="Right"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding StatusIcon}" Width="20"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding StatusText}" Width="80" VerticalAlignment="Center" />
                                <ProgressBar IsIndeterminate="True" Width="60" Height="14"
                                             Margin="6,0,0,0"
                                             IsVisible="{Binding IsProcessing}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </Border>
                </Border>

                <!-- Drag-over highlight: navy frame replaces the chiseled border while a valid file drag hovers -->
                <Border x:Name="DropHighlight"
                        BorderBrush="{StaticResource ClassicHighlight}"
                        BorderThickness="2"
                        IsVisible="False"
                        IsHitTestVisible="False" />

                <!-- 빈 상태 안내 문구 -->
                <TextBlock x:Name="EmptyHint"
                           Text="여기에 파일을 끌어다 놓으세요&#x0a;또는 상단의 [파일 추가] 버튼을 클릭하세요"
                           FontSize="15" Foreground="{StaticResource ClassicGrayText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center"
                           IsVisible="{Binding IsEmpty}"
                           IsHitTestVisible="False" />
            </Grid>

            <!-- GridSplitter (Win9x etched groove: shadow left, highlight right) -->
            <Grid Grid.Column="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Width="1" Background="{StaticResource ClassicButtonShadow}" />
                    <Border Width="1" Background="{StaticResource ClassicButtonHilight}" />
                </StackPanel>
                <GridSplitter Width="4" HorizontalAlignment="Stretch"
                              Background="Transparent" />
            </Grid>

            <!-- RIGHT: 로그 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- 로그 헤더: 제목 + '로그 지우기' 버튼 (상단바에서 이동) -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="로그" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="4,0,0,0" />
                    <Button Content="로그 지우기" Padding="8,2" MinWidth="70"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding ClearLogCommand}" />
                </Grid>
                <!-- Chiseled inset frame (Win9x sunken border) -->
                <Border Grid.Row="1"
                        BorderBrush="{StaticResource ClassicButtonShadow}"
                        BorderThickness="1,1,0,0">
                    <Border BorderBrush="{StaticResource ClassicButtonHilight}"
                            BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding LogText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 ScrollViewer.ScrollChanged="LogTextBox_ScrollChanged"
                                 BorderThickness="0"
                                 FontFamily="Consolas, Menlo" FontSize="12"
                                 TextWrapping="Wrap"
                                 Background="{StaticResource ClassicButtonHilight}"
                                 AcceptsReturn="True" />
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
